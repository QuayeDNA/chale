# Public web app environment. Copy to .env.local and fill in.
# Nothing here is secret: Vite embeds these values in the static bundle.

# Supabase project URL and anon key (the Edge Functions use the project URL).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public site origin used in confirmation emails and referral links.
# Include the sub-path if the build is not hosted at the root.
VITE_SITE_URL=https://chale.space

# Real contact address shown on Terms and Privacy. Set this before launch.
VITE_CONTACT_EMAIL=hello@chale.space

# Cloudflare Turnstile site key. Leave blank to disable the widget in local
# development; set it in production alongside TURNSTILE_SECRET.
VITE_TURNSTILE_SITE_KEY=
