# Supabase project — fill these in for local development.
# Copy to .env (gitignored) and set real values. Do not commit real values.

# Project reference (the <ref> in <ref>.supabase.co) — from the Supabase dashboard.
SUPABASE_PROJECT_REF=your-project-ref

# Region code of the project, e.g. us-east-1 (used by scripts only).
SUPABASE_REGION=us-east-1

# Postgres database password — set when the project was created.
# Tooling-only (psql, supabase link/db reset); never shipped to the app.
SUPABASE_DB_PASSWORD=your-db-password

# Base URL of the Supabase project API.
SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key (safe to embed in the app; RLS enforces access).
SUPABASE_ANON_KEY=your-anon-key

# Expo reads EXPO_PUBLIC_* vars from .env at build time. Same values as above.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key