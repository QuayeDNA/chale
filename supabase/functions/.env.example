# Local Edge Function secrets. Copy to supabase/functions/.env for
# `supabase functions serve`, then set the same values in production with
# `supabase secrets set --env-file supabase/functions/.env`.

# Public site origin. Confirmation links use <SITE_URL>/confirm?token=...
# Use http://localhost:5173 when testing locally.
SITE_URL=https://chale.space

# Resend. Verify the sending domain in Resend before using it here.
RESEND_API_KEY=
WAITLIST_FROM_EMAIL=Chale <hello@chale.space>
WAITLIST_REPLY_TO=hello@chale.space

# Optional local escape hatch: log the confirmation link instead of emailing.
# Never use this in production. Values: resend | log
WAITLIST_EMAIL_MODE=resend

# Optional Cloudflare Turnstile. If TURNSTILE_SECRET is set, the join function
# requires a valid token from the web widget.
TURNSTILE_SECRET=

# Optional salt for hashing rate-limit IPs. Set a long random value in prod.
WAITLIST_IP_SALT=
